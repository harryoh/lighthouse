{
  "name": "@lighthouse/api",
  "version": "1.0.0",
  "description": "Lighthouse API Server",
  "scripts": {
    "build": "nx build api",
    "dev": "nx serve api",
    "start": "node ../../dist/apps/api/main.js",
    "test": "jest --passWithNoTests --forceExit",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:fix": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "depcheck": "depcheck . --skip-missing=true"
  }
}
