# Database Configuration
DATABASE_URL="mysql://lighthouse_user:lighthouse_password@localhost:3306/lighthouse"

# Redis Configuration
REDIS_URL="redis://localhost:6379"

# LocalStack Configuration (AWS Services)
AWS_ENDPOINT="http://localhost:4566"
AWS_ACCESS_KEY_ID="test"
AWS_SECRET_ACCESS_KEY="test"
AWS_DEFAULT_REGION="us-east-1"

# Application Configuration
NODE_ENV="development"
PORT="3000"

# Security (Optional - has defaults for development)
# JWT_SECRET="your-super-secret-jwt-key-minimum-32-characters-long"
# JWT_EXPIRES_IN="7d"

# Crawler Configuration (Optional - has defaults)
# CRAWLER_USER_AGENT="Mozilla/5.0 (compatible; Lighthouse/1.0; +http://lighthouse.com/bot)"
# CRAWLER_CONCURRENT_REQUESTS="5"
# CRAWLER_REQUEST_DELAY="1000"

# Queue Configuration (Optional - has defaults)
# QUEUE_MAX_RETRIES="3"
# QUEUE_RETRY_DELAY="5000"