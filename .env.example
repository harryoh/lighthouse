# Database Configuration
DATABASE_URL="mysql://lighthouse_user:lighthouse_password@localhost:3307/lighthouse"

# Redis Configuration
REDIS_URL="redis://localhost:6380"
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""
REDIS_DB="0"
REDIS_MAX_RETRIES="3"
REDIS_RETRY_DELAY="1000"

# LocalStack Configuration (AWS Services)
AWS_ENDPOINT="http://localhost:4567"
AWS_ACCESS_KEY_ID="test"
AWS_SECRET_ACCESS_KEY="test"
AWS_DEFAULT_REGION="us-east-1"

# Application Configuration
NODE_ENV="development"
PORT="3001"

# Security (Optional - has defaults for development)
# JWT_SECRET="your-super-secret-jwt-key-minimum-32-characters-long"
# JWT_EXPIRES_IN="7d"

# Crawler Configuration (Optional - has defaults)
# CRAWLER_USER_AGENT="Mozilla/5.0 (compatible; Lighthouse/1.0; +http://lighthouse.com/bot)"
# CRAWLER_CONCURRENT_REQUESTS="5"
# CRAWLER_REQUEST_DELAY="1000"

# Queue Configuration (Optional - has defaults)
# QUEUE_MAX_RETRIES="3"
# QUEUE_RETRY_DELAY="5000"
# QUEUE_CRAWL_CONCURRENCY="5"
# QUEUE_ANALYSIS_CONCURRENCY="10"
# QUEUE_SCHEDULED_CONCURRENCY="2"
# QUEUE_DEFAULT_ATTEMPTS="3"
# QUEUE_DEFAULT_BACKOFF_DELAY="5000"
# QUEUE_HEALTH_CHECK_INTERVAL="30000"
# QUEUE_ENABLE_METRICS="true"
# QUEUE_DLQ_ENABLED="true"
# QUEUE_DLQ_MAX_RETRIES="3"
# QUEUE_DLQ_TTL="86400"