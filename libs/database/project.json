{
  "name": "database",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/database/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/database",
        "main": "libs/database/src/index.ts",
        "tsConfig": "libs/database/tsconfig.lib.json",
        "assets": ["libs/database/*.md"]
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p libs/database/tsconfig.lib.json"
      }
    },
    "depcheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "depcheck libs/database --ignores=\"@types/*,@nx/*,jest,typescript,eslint*,@typescript-eslint/*,@swc/*\""
      }
    }
  }
}
