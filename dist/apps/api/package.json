{
  "name": "@lighthouse/api",
  "version": "1.0.0",
  "description": "Lighthouse API Server",
  "scripts": {
    "build": "nx build api",
    "dev": "nx serve api",
    "start": "node ../../dist/apps/api/main.js",
    "test": "jest --passWithNoTests --forceExit",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:fix": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "depcheck": "depcheck . --skip-missing=true"
  },
  "dependencies": {
    "cors": "2.8.5",
    "dotenv": "17.2.1",
    "express": "4.21.2",
    "redis": "5.8.1",
    "zod": "4.0.17"
  },
  "main": "./main.js",
  "type": "commonjs"
}